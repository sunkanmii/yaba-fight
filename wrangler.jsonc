{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaba-fight",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-17",
  "assets": {"directory": "./out", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "durable_objects": {"bindings": [
    {"name": "FIGHT_ROOMS", "class_name": "FightRoom"},
    {"name": "MATCHMAKER", "class_name": "Matchmaker"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["FightRoom", "Matchmaker"]}],
  "ratelimits": [{"name": "ROOM_LIMITER", "namespace_id": "1001", "simple": {"limit": 30, "period": 60}}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "traces": {"enabled": true, "head_sampling_rate": 0.1}}
}
